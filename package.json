{
  "name": "@yangtianming314/dsh-architect",
  "version": "0.3.0",
  "description": "DSH AI architect orchestration plugin with role routing, hard tool permissions, concurrency governance, and delivery settings.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": ["lib", "README.md", "README.en.md", "LICENSE", "cordis.patch.yml"],
  "scripts": {
    "test": "node --test tests/*.test.js"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/yangtianming314/dsh-architect.git"
  },
  "bugs": {
    "url": "https://github.com/yangtianming314/dsh-architect/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-api-gateway"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-settings": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-llm": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-typert-protocol": "^0.1.0-rc.6",
    "@deepseek-ai/schemastery": "^1.0.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0"
  }
}
